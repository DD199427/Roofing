   "source": [
    "import torch\n",
    "import torch.nn.functional as F\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from captum.attr import LayerGradCam, IntegratedGradients, visualization as viz\n",
    "\n",
    "# 1. Setup the XAI Tools\n",
    "def explain_roof_prediction(model, input_tensor, target_layer):\n",
    "    model.eval()\n",
    "    \n",
    "    # --- 1. FIND THE TARGET PIXEL ---\n",
    "    with torch.no_grad():\n",
    "        output = model(input_tensor)\n",
    "        # Find the max confidence pixel\n",
    "        _, flattened_idx = torch.max(output.flatten(), 0)\n",
    "        coords = np.unravel_index(flattened_idx.cpu().numpy(), output.shape[1:])\n",
    "        target_coords = (int(coords[0]), int(coords[1]), int(coords[2]))\n",
    "        \n",
    "        # Explicitly delete output to save space\n",
    "        del output\n",
    "        torch.cuda.empty_cache()\n",
    "\n",
    "    print(f\"Targeting Pixel: {target_coords}\")\n",
    "\n",
    "    # --- 2. GRAD-CAM (Usually light, but we wrap in a block) ---\n",
    "    lgc = LayerGradCam(model, target_layer)\n",
    "    gc_attr = lgc.attribute(input_tensor, target=target_coords)\n",
    "\n",
    "    # --- 3. INTEGRATED GRADIENTS (The memory hog) ---\n",
    "    ig = IntegratedGradients(model)\n",
    "    \n",
    "    # THE FIX: internal_batch_size=1 or 2\n",
    "    # This processes the 50 steps in small chunks instead of all at once\n",
    "    ig_attr = ig.attribute(\n",
    "        input_tensor, \n",
    "        target=target_coords, \n",
    "        n_steps=25,              # Reduced from 50 to 25 for safety\n",
    "        internal_batch_size=1    # CRITICAL: Processes 1 step at a time\n",
    "    )\n",
    "\n",
    "    return gc_attr, ig_attr\n",
    "\n",
    "# 2. Visualization Logic\n",
    "def plot_explanations(img, gc_attr, ig_attr):\n",
    "    # Convert tensors back to numpy for plotting\n",
    "    img_np = img.squeeze().permute(1, 2, 0).cpu().detach().numpy()\n",
    "    \n",
    "    # Grad-CAM needs to be upsampled to match image size\n",
    "    gc_upsampled = LayerGradCam.interpolate(gc_attr, (608, 608)).squeeze().cpu().detach().numpy()\n",
    "    \n",
    "    # IG needs to be transposed for viz library [H, W, C]\n",
    "    ig_np = ig_attr.squeeze().permute(1, 2, 0).cpu().detach().numpy()\n",
    "\n",
    "    fig, ax = plt.subplots(1, 3, figsize=(20, 10))\n",
    "    \n",
    "    # Original\n",
    "    ax[0].imshow(img_np)\n",
    "    ax[0].set_title(\"Original Image\")\n",
    "    \n",
    "    # Grad-CAM (The \"Focus\")\n",
    "    ax[1].imshow(img_np, alpha=0.5)\n",
    "    ax[1].imshow(gc_upsampled, cmap='jet', alpha=0.5)\n",
    "    ax[1].set_title(\"Grad-CAM (Area of Interest)\")\n",
    "    \n",
    "    # Integrated Gradients (The \"Evidence\")\n",
    "    # Using captum's viz tool to show pixel importance\n",
    "    viz.visualize_image_attr(ig_np, img_np, method=\"blended_heat_map\", \n",
    "                             sign=\"positive\", show_colorbar=True, plt_fig_axis=(fig, ax[2]))\n",
    "    ax[2].set_title(\"Integrated Gradients (Pixel Evidence)\")\n",
    "    \n",
    "    plt.show()\n",
    "\n",
    "# --- RUNNING IT ---\n",
    "# Use the last layer of your encoder or the final output layer\n",
    "# For U-Net, the bottleneck (model.down4) or final layer (model.outc) are best\n",
    "target_layer = loaded_model.outc \n",
    "\n",
    "# 1. Pick an image from your test set\n",
    "image_path = r\"data\\valid\\image\\36.832587_-119.736896_sunroof_rgb.tif\" \n",
    "\n",
    "# 2. Load and Preprocess (Exactly like you did in the Dataset class)\n",
    "with rasterio.open(image_path) as src:\n",
    "    img = src.read([1, 2, 3])\n",
    "    img = np.transpose(img, (1, 2, 0)).astype(np.float32)\n",
    "    img /= 255.0 if np.max(img) > 1.0 else 1.0\n",
    "\n",
    "# 3. Apply the 'Safe' Transform (with the padding fix we discussed)\n",
    "# Make sure 'transform' here matches your training padding!\n",
    "transform = A.Compose([\n",
    "        A.PadIfNeeded(min_height=608, min_width=608, border_mode=0,value=0,mask_value=0),\n",
    "        ToTensorV2()\n",
    "    ])\n",
    "input_data = transform(image=img)\n",
    "image_tensor = input_data['image'] # This is [3, 608, 608]\n",
    "\n",
    "# 4. Add the 'Batch' dimension and move to Device\n",
    "# Models expect [Batch, Channel, H, W], so we unsqueeze to add the '1'\n",
    "input_tensor = image_tensor.unsqueeze(0).to(device) \n",
    "\n",
    "print(f\"input_tensor defined! Shape: {input_tensor.shape}\")\n",
    "\n",
    "device = torch.device(\"cpu\")\n",
    "loaded_model.to(device)\n",
    "input_tensor = input_tensor.to(device)\n",
    "\n",
    "gc, ig = explain_roof_prediction(loaded_model, input_tensor, target_layer)\n",
    "plot_explanations(input_tensor, gc, ig)"
   ]
  },
