    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "def plot_ig_density(ig_attr):\n",
    "    # 1. Prepare the data\n",
    "    # We take the absolute value because we care about 'importance' (magnitude)\n",
    "    # whether it's positive or negative.\n",
    "    attr_flat = torch.abs(ig_attr).cpu().detach().numpy().flatten()\n",
    "    \n",
    "    # 2. Filter out the absolute zeros (padding/background) to see the detail\n",
    "    # We only want to look at pixels that have *some* influence\n",
    "    attr_filtered = attr_flat[attr_flat > 1e-5]\n",
    "\n",
    "    # 3. Plotting\n",
    "    plt.figure(figsize=(10, 6))\n",
    "    sns.kdeplot(attr_filtered, fill=True, color=\"blue\", bw_adjust=0.5)\n",
    "    \n",
    "    plt.title(\"Integrated Gradients: Attribution Density\", fontsize=14)\n",
    "    plt.xlabel(\"Attribution Magnitude (Importance Score)\", fontsize=12)\n",
    "    plt.ylabel(\"Density\", fontsize=12)\n",
    "    plt.grid(axis='y', alpha=0.3)\n",
    "    \n",
    "    # Add a vertical line for the mean 'importance'\n",
    "    plt.axvline(np.mean(attr_filtered), color='red', linestyle='--', label=f'Mean Importance')\n",
    "    plt.legend()\n",
    "    \n",
    "    plt.show()\n",
    "\n",
    "# Run it on your IG result\n",
    "plot_ig_density(ig)"
   ]
